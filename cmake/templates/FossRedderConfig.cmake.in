@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(OpenCV REQUIRED)
find_dependency(PkgConfig REQUIRED)
find_dependency(SQLite3 REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(Tesseract CONFIG REQUIRED)
find_dependency(xlnt CONFIG REQUIRED)

pkg_check_modules(LIBZIP REQUIRED IMPORTED_TARGET libzip)
pkg_check_modules(POPPLER_CPP REQUIRED IMPORTED_TARGET poppler-cpp)

if(NOT "@FOSSREDDER_QT_PUBLIC_COMPONENTS@" STREQUAL "")
    find_dependency(Qt6 REQUIRED COMPONENTS @FOSSREDDER_QT_PUBLIC_COMPONENTS@)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FossRedderTargets.cmake")

check_required_components(FossRedder)
