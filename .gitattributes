# Normalize repository text files to LF unless a file type needs CRLF locally.
* text=auto eol=lf

# Repository metadata
.clang-format text eol=lf
.clang-tidy text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
CODEOWNERS text eol=lf
CONTRIBUTING.md text eol=lf diff=markdown
LICENSE text eol=lf
README.md text eol=lf diff=markdown
ROADMAP.md text eol=lf diff=markdown

# C++ and CMake
*.c text eol=lf diff=cpp
*.cc text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.cxx text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.hh text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.hxx text eol=lf diff=cpp
*.inl text eol=lf diff=cpp
*.ixx text eol=lf diff=cpp
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf

# Qt, QML and UI text assets
*.js text eol=lf
*.qml text eol=lf
*.qrc text eol=lf diff=xml
*.svg text eol=lf diff=xml
*.ts text eol=lf diff=xml
qmldir text eol=lf

# Project configuration and documentation
*.html text eol=lf diff=html
*.in text eol=lf
*.iss text eol=lf
*.json text eol=lf
*.md text eol=lf diff=markdown
*.txt text eol=lf
*.xml text eol=lf diff=xml
*.yaml text eol=lf
*.yml text eol=lf
Doxyfile text eol=lf

# Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Images and icons
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary

# Runtime, package and generated binary artifacts
*.7z binary
*.a binary
*.dll binary
*.docx binary
*.dylib binary
*.exe binary
*.gz binary
*.lib binary
*.msi binary
*.o binary
*.obj binary
*.pdb binary
*.pdf binary
*.qm binary
*.rcc binary
*.so binary
*.tar binary
*.traineddata binary
*.xls binary
*.xlsx binary
*.zip binary
